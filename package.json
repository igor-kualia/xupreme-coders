{
  "name": "xupreme-coders",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"convex/**/*.{ts,js,json}\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"convex/**/*.{ts,js,json}\"",
    "check": "npm run format:check && npm run lint && npm run test -- --no-watch --no-progress --browsers=ChromeHeadless && npm run build",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.10",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@auth0/auth0-angular": "^2.3.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": ">=29.0.0",
    "@spartan-ng/brain": "^0.0.1-alpha.538",
    "@tailwindcss/postcss": "^4.1.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "convex": "^1.28.0",
    "embla-carousel-angular": ">=19.0.0",
    "jwks-rsa": "^3.2.0",
    "lucide": "^0.548.0",
    "ngx-sonner": ">=3.0.0",
    "openai": "^6.7.0",
    "plaid": "^35.0.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.7",
    "@angular/cli": "^20.3.7",
    "@angular/compiler-cli": "^20.3.0",
    "@cypress/schematic": "^4.1.4",
    "@spartan-ng/cli": "^0.0.1-alpha.538",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.9.2",
    "angular-eslint": "20.5.0",
    "cypress": "15.5.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.1"
  }
}
